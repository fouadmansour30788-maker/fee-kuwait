# ── FEE Kuwait — environment ────────────────────────────────────────
# Copy this file to `.env.local` and fill in your Supabase project values.
# Find them in Supabase → Project Settings → API.
#
# .env.local is git-ignored — never commit real keys.

# Project URL, e.g. https://abcdxyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon"/publishable key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — SERVER ONLY, bypasses row-level security.
# Used for admin tasks / seeding. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email notifications (Resend) ────────────────────────────────────
# API key from resend.com → API Keys. Applicants get emailed on status changes.
RESEND_API_KEY=

# Verified sender. Until you verify a domain in Resend, leave this unset and
# it falls back to onboarding@resend.dev (only delivers to the account owner).
# Once your domain is live, e.g. EMAIL_FROM="FEE Kuwait <no-reply@yourdomain.org>"
EMAIL_FROM=

# Public site URL (used to build portal links inside emails), e.g. https://fee-kuwait.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── AI assistant (Google Gemini) ────────────────────────────────────
# API key from Google AI Studio (aistudio.google.com/app/apikey). Powers the chat
# widget via /api/chat. SERVER ONLY — never expose to the browser.
GEMINI_API_KEY=
# Optional model override (default gemini-2.5-flash)
GEMINI_MODEL=
